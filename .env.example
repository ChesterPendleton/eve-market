# Copy to .env and fill in. setup.sh does this for you.

# --- Required by CCP -------------------------------------------------------
# ESI requires a contact address in the User-Agent. Requests without one get
# throttled hard, and CCP will not warn you first.
EVE_CONTACT_EMAIL=you@example.com

# --- Mode ------------------------------------------------------------------
# false = serve everything from tests/fixtures (no network needed)
# true  = hit the real ESI
EVE_ESI_LIVE=true

# --- Infrastructure --------------------------------------------------------
EVE_DATABASE_URL=postgresql://eve:eve@localhost:5432/eve_market
EVE_REDIS_URL=redis://localhost:6379/0

# --- Trading rates (adjust to your skills and standings) -------------------
# Sales tax: 8% base, -11% per level of Accounting. 0.036 = Accounting V.
EVE_SALES_TAX=0.036
# Broker fee: 3% base, reduced by Broker Relations and faction/corp standings.
EVE_BROKER_FEE=0.015

# --- Destination market ----------------------------------------------------
# Run `eve-market resolve Ahbazon` to fill these in from ESI. The defaults are
# unverified; a wrong region id means you analyse an empty market silently.
EVE_DEST_NAME=Ahbazon
EVE_DEST_REGION_ID=10000067
EVE_DEST_SYSTEM_ID=0
EVE_DEST_IS_LOWSEC=true

# --- Logistics -------------------------------------------------------------
# blockade_runner | dst | freighter
EVE_SHIP=dst
EVE_CARGO_M3=0
EVE_SELF_HAULING=true

# --- Pricing behaviour -----------------------------------------------------
EVE_UNDERCUT_ISK=0.01
EVE_GREENFIELD_MARKUP=0.35
EVE_DAYS_OF_STOCK=7.0
EVE_CAPTURE_RATE=0.25

# --- SSO -------------------------------------------------------------------
# Needed for your own orders, wallet sync and opening client windows. Public
# market data works without it. Register a NATIVE application at
# https://developers.eveonline.com/applications and set its callback URL to
# exactly the value below. No client secret: this uses the PKCE flow.
EVE_CLIENT_ID=
EVE_CALLBACK_URL=http://localhost:8000/callback
