# Copy to .env and fill in. setup.sh does this for you.

# --- Required by CCP -------------------------------------------------------
# ESI requires a contact address in the User-Agent. Requests without one get
# throttled hard, and CCP will not warn you first.
EVE_CONTACT_EMAIL=you@example.com

# --- Mode ------------------------------------------------------------------
# false = serve everything from tests/fixtures (no network needed)
# true  = hit the real ESI
EVE_ESI_LIVE=true

# --- Infrastructure --------------------------------------------------------
EVE_DATABASE_URL=postgresql://eve:eve@localhost:5432/eve_market
EVE_REDIS_URL=redis://localhost:6379/0

# --- Trading rates (adjust to your skills and standings) -------------------
# Sales tax: 8% base, -11% per level of Accounting. 0.036 = Accounting V.
EVE_SALES_TAX=0.036
# Broker fee: 3% base, reduced by Broker Relations and faction/corp standings.
EVE_BROKER_FEE=0.015

# --- SSO (only needed for character-scoped endpoints; public market is open) -
# Register an application at https://developers.eveonline.com/applications
EVE_CLIENT_ID=
EVE_CLIENT_SECRET=
EVE_CALLBACK_URL=http://localhost:8000/callback
